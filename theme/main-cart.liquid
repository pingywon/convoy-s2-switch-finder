{%- comment -%}
  GAD-948 (v2 live) — checkout friction + cyberpunk alignment.
  Changes vs. original (preserved CHECKOUT button color per board direction):
  - Free-shipping progress line above totals
  - <shopify-accelerated-checkout-cart> wallet block (Shop Pay / Apple Pay / Google Pay / PayPal / Venmo)
  - Trust line under CHECKOUT button (secure-checkout / 14-day defective / contact@)
  - Cart line + totals panel tweaked to match the cyberpunk mailer palette (phosphor accents)
{%- endcomment -%}

{%- assign free_ship_cents = 10000 -%}{%- comment -%} $100 threshold {%- endcomment -%}
{%- assign remaining_cents = free_ship_cents | minus: cart.total_price -%}
{%- if remaining_cents < 0 -%}{%- assign remaining_cents = 0 -%}{%- endif -%}
{%- assign progress_pct = cart.total_price | times: 100 | divided_by: free_ship_cents -%}
{%- if progress_pct > 100 -%}{%- assign progress_pct = 100 -%}{%- endif -%}

<style>
  #section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    {% if section.settings.background_style == 'panel' %}
      background: rgba(255, 255, 255, 0.04);
    {% elsif section.settings.background_style == 'muted' %}
      background: rgba(0, 0, 0, 0.2);
    {% endif %}
  }
  #section-{{ section.id }} .gc-page__title {
    color: {{ section.settings.heading_color | default: '#ffffff' }};
  }
  #section-{{ section.id }} .gc-page__tag,
  #section-{{ section.id }} .gc-cart__subtotal-label,
  #section-{{ section.id }} .gc-cart__taxes {
    color: {{ section.settings.body_color | default: '#d4d6db' }};
  }

  /* GAD-948 v2: hidden Enter-submit fallback (replaces visible UPDATE button) */
  .gc-cart__update-hidden {
    position: absolute; left: -9999px; width: 1px; height: 1px;
    opacity: 0; pointer-events: none; border: 0; padding: 0; margin: 0;
  }

  /* GAD-948: cyberpunk-aligned cart container */
  #section-{{ section.id }} .gc-cart__lines {
    border-top: 1px solid rgba(0, 255, 159, 0.18);
    border-bottom: 1px solid rgba(0, 255, 159, 0.18);
  }
  #section-{{ section.id }} .gc-cart__line {
    border-bottom: 1px dashed rgba(0, 255, 159, 0.10);
  }
  #section-{{ section.id }} .gc-cart__line:last-child { border-bottom: 0; }
  #section-{{ section.id }} .gc-cart__line-remove {
    color: var(--gc-warn, #ff2d6f) !important;
    text-shadow: 0 0 6px rgba(255, 45, 111, 0.35);
  }
  #section-{{ section.id }} .gc-cart__totals {
    background: rgba(0, 255, 159, 0.03);
    border: 1px solid rgba(0, 255, 159, 0.18);
    padding: 18px;
    margin-top: 14px;
  }
  #section-{{ section.id }} .gc-cart__subtotal-value {
    color: var(--gc-phosphor, #00ff9f);
    text-shadow: 0 0 6px rgba(0, 255, 159, 0.35);
  }

  /* GAD-948: free-shipping progress */
  .gc-cart__ship {
    margin: 6px 0 14px;
    font-family: var(--gc-ff-body, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--gc-fg, #c8d4d8);
  }
  .gc-cart__ship-bar {
    margin-top: 6px;
    height: 6px;
    background: rgba(0, 255, 159, 0.10);
    border: 1px solid rgba(0, 255, 159, 0.25);
    position: relative;
    overflow: hidden;
  }
  .gc-cart__ship-fill {
    position: absolute; top: 0; left: 0; bottom: 0;
    background: var(--gc-phosphor, #00ff9f);
    box-shadow: 0 0 10px rgba(0, 255, 159, 0.55);
    transition: width 0.4s ease;
  }
  .gc-cart__ship--unlocked .gc-cart__ship-fill { background: var(--gc-phosphor, #00ff9f); }

  /* GAD-948: accelerated checkout block */
  .gc-cart__wallets {
    margin: 14px 0 10px;
  }
  .gc-cart__wallets shopify-accelerated-checkout-cart,
  .gc-cart__wallets shopify-accelerated-checkout {
    display: block;
    --shopify-accelerated-checkout-button-block-size: 48px;
    --shopify-accelerated-checkout-button-border-radius: 0px;
    --shopify-accelerated-checkout-row-gap: 8px;
    --shopify-accelerated-checkout-inline-alignment: stretch;
  }
  .gc-cart__or {
    display: flex; align-items: center; gap: 10px;
    margin: 8px 0;
    font-family: var(--gc-ff-body, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gc-fg-dim, #5a6b73);
  }
  .gc-cart__or::before,
  .gc-cart__or::after {
    content: ""; flex: 1; height: 1px; background: rgba(0, 255, 159, 0.18);
  }

  /* GAD-948: trust line under CHECKOUT */
  .gc-cart__trust {
    margin-top: 12px;
    text-align: center;
    font-family: var(--gc-ff-body, 'JetBrains Mono', ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.10em;
    color: var(--gc-fg-dim, #5a6b73);
    line-height: 1.55;
  }
  .gc-cart__trust a {
    color: var(--gc-phosphor, #00ff9f);
    text-decoration: none;
    border-bottom: 1px dotted rgba(0, 255, 159, 0.45);
  }
  .gc-cart__trust-row { display: block; }

  /* ===== custom-build grouping + spec rows (GC S2+ builder) ===== */
  .gc-cart__lines { font-size: 17px; }
  .gc-cart__line-title { font-size: 21px; line-height: 1.25; margin: 0 0 4px; }
  .gc-cart__line-variant { font-size: 16px; opacity: .85; }
  .gc-cart__line-price { font-size: 20px; font-weight: 700; }

  .gc-build {
    border: 2px solid rgba(0, 255, 159, .40);
    border-radius: 10px;
    background: rgba(0, 255, 159, .045);
    margin: 0 0 22px;
    overflow: hidden;
  }
  .gc-build__head {
    display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start;
    justify-content: space-between;
    padding: 18px 20px;
    background: rgba(0, 255, 159, .10);
    border-bottom: 2px solid rgba(0, 255, 159, .30);
  }
  .gc-build__tag {
    display: inline-block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px; letter-spacing: .18em; text-transform: uppercase;
    color: #00ff9f; margin-bottom: 6px;
  }
  .gc-build__name {
    font-size: 26px; line-height: 1.15; margin: 0; color: #ffffff; font-weight: 800;
  }
  .gc-build__light { margin: 6px 0 0; font-size: 16px; color: #d4d6db; }
  .gc-build__meta { text-align: right; display: flex; flex-direction: column; gap: 4px; }
  .gc-build__count {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px; color: #9fb0bf; letter-spacing: .04em;
  }
  .gc-build__total { font-size: 22px; font-weight: 800; color: #ffffff; }
  .gc-build__lines { padding: 4px 16px; }
  .gc-build__lines .gc-cart__line + .gc-cart__line {
    border-top: 1px dashed rgba(159, 176, 191, .28);
  }
  .gc-build__note {
    margin: 0; padding: 12px 20px 16px; font-size: 15px; color: #9fb0bf;
    border-top: 1px solid rgba(0, 255, 159, .18);
  }

  .gc-spec__role {
    display: inline-block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase;
    color: #00ff9f; border: 1px solid rgba(0, 255, 159, .45);
    background: rgba(0, 255, 159, .10);
    padding: 3px 9px; border-radius: 4px; margin-bottom: 8px;
  }
  .gc-spec { margin: 10px 0 6px; padding: 0; display: grid; gap: 6px; }
  .gc-spec__row {
    display: grid; grid-template-columns: 180px 1fr; gap: 14px; align-items: baseline;
    padding: 8px 0; border-top: 1px solid rgba(159, 176, 191, .18);
  }
  .gc-spec__row:first-child { border-top: none; }
  .gc-spec dt {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px; letter-spacing: .09em; text-transform: uppercase;
    color: #9fb0bf; margin: 0;
  }
  .gc-spec dd { margin: 0; font-size: 17px; line-height: 1.4; color: #ffffff; font-weight: 600; }
  @media (max-width: 640px) {
    .gc-spec__row { grid-template-columns: 1fr; gap: 2px; }
    .gc-build__head { flex-direction: column; }
    .gc-build__meta { text-align: left; }
    .gc-build__name { font-size: 22px; }
  }
</style>
<div id="section-{{ section.id }}" class="gc-cart">
  <header class="gc-page__head">
    <div class="gc-page__tag">// CART</div>
    <h1 class="gc-page__title">{%- if cart.item_count > 0 -%}&gt; PACKET DELIVERED — CART += {{ cart.item_count }}{%- else -%}{{ 'general.cart.title' | t }}{%- endif -%}</h1>
  </header>

  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart -%}
      {%- comment -%} GAD-948 v2: captures Enter-key submit so qty input keeps working after removing the visible UPDATE button. Must be the first submit in the form so Enter triggers it, not CHECKOUT. {%- endcomment -%}
      <button type="submit" name="update" class="gc-cart__update-hidden" aria-hidden="true" tabindex="-1"></button>

      {%- comment -%}
        Custom builds arrive as several cart lines that belong together. Group them
        under one header so the customer (and we, on the order) can see at a glance
        which switch, button and clip go with which light. _gc_build is the key.
      {%- endcomment -%}
      {%- assign build_keys = '' -%}
      {%- for item in cart.items -%}
        {%- assign bk = item.properties['_gc_build'] -%}
        {%- if bk != blank -%}
          {%- assign probe = '~|~' | append: bk | append: '~|~' -%}
          {%- unless build_keys contains probe -%}
            {%- assign build_keys = build_keys | append: probe -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="gc-cart__lines">
        {%- assign bk_list = build_keys | split: '~|~' -%}
        {%- for bk in bk_list -%}
          {%- if bk == blank -%}{%- continue -%}{%- endif -%}
          {%- assign part_count = 0 -%}
          {%- assign light_desc = '' -%}
          {%- assign build_total = 0 -%}
          {%- for item in cart.items -%}
            {%- if item.properties['_gc_build'] == bk -%}
              {%- assign part_count = part_count | plus: item.quantity -%}
              {%- assign build_total = build_total | plus: item.final_line_price -%}
              {%- if light_desc == blank -%}
                {%- assign light_desc = item.properties['_gc_light'] -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          <section class="gc-build">
            <header class="gc-build__head">
              <div class="gc-build__id">
                <span class="gc-build__tag">CUSTOM BUILD</span>
                <h2 class="gc-build__name">{{ bk }}</h2>
                {%- if light_desc != blank -%}
                  <p class="gc-build__light">{{ light_desc }}</p>
                {%- endif -%}
              </div>
              <div class="gc-build__meta">
                <span class="gc-build__count">{{ part_count }} part{% if part_count != 1 %}s{% endif %} in this build</span>
                <span class="gc-build__total">{{ build_total | money }}</span>
              </div>
            </header>
            <div class="gc-build__lines">
              {%- comment -%} the light first, then its parts {%- endcomment -%}
              {%- for item in cart.items -%}
                {%- if item.properties['_gc_build'] == bk and item.properties['_gc_role'] == 'The light' -%}
                  {%- render 'gc-cart-line', item: item, routes: routes -%}
                {%- endif -%}
              {%- endfor -%}
              {%- comment -%} parts in a sensible fitting order, not cart order {%- endcomment -%}
              {%- assign role_order = 'Tail switch,Centre button,Rubber tail button,Pocket clip' | split: ',' -%}
              {%- for r in role_order -%}
                {%- for item in cart.items -%}
                  {%- if item.properties['_gc_build'] == bk and item.properties['_gc_role'] == r -%}
                    {%- render 'gc-cart-line', item: item, routes: routes -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
              {%- comment -%} anything with a role we did not anticipate still shows {%- endcomment -%}
              {%- for item in cart.items -%}
                {%- assign r2 = item.properties['_gc_role'] -%}
                {%- if item.properties['_gc_build'] == bk and r2 != 'The light' and r2 != blank -%}
                  {%- unless role_order contains r2 -%}
                    {%- render 'gc-cart-line', item: item, routes: routes -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="gc-build__note">These parts ship together, fitted to this light.</p>
          </section>
        {%- endfor -%}

        {%- comment -%} everything that is not part of a build {%- endcomment -%}
        {%- for item in cart.items -%}
          {%- if item.properties['_gc_build'] == blank -%}
            {%- render 'gc-cart-line', item: item, routes: routes -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="gc-cart__foot">
        <div class="gc-cart__note">
          <label for="gc-cart-note">{{ 'general.cart.note' | t | upcase }}</label>
          <textarea id="gc-cart-note" name="note">{{ cart.note }}</textarea>
        </div>

        <div class="gc-cart__totals">
          {%- if remaining_cents > 0 -%}
            <div class="gc-cart__ship">
              <span>// {{ remaining_cents | money_without_trailing_zeros }} to free U.S. ground shipping</span>
              <div class="gc-cart__ship-bar"><div class="gc-cart__ship-fill" style="width: {{ progress_pct }}%;"></div></div>
            </div>
          {%- else -%}
            <div class="gc-cart__ship gc-cart__ship--unlocked">
              <span>// FREE U.S. GROUND SHIPPING UNLOCKED</span>
              <div class="gc-cart__ship-bar"><div class="gc-cart__ship-fill" style="width: 100%;"></div></div>
            </div>
          {%- endif -%}

          <div class="gc-cart__subtotal">
            <span class="gc-cart__subtotal-label">{{ 'general.cart.subtotal' | t }}</span>
            <span class="gc-cart__subtotal-value">{{ cart.total_price | money }}</span>
          </div>
          <div class="gc-cart__taxes">{{ 'general.cart.taxes_and_shipping_at_checkout' | t }}</div>

          <div class="gc-cart__wallets">
            <shopify-accelerated-checkout-cart></shopify-accelerated-checkout-cart>
          </div>
          <div class="gc-cart__or">or pay manually</div>

          <button type="submit" name="checkout" class="gc-btn gc-btn--warn gc-btn--full">&gt; {{ 'general.cart.checkout' | t | upcase }} _</button>

          <div class="gc-cart__trust">
            <span class="gc-cart__trust-row">// SSL SECURE CHECKOUT VIA SHOPIFY · 14-DAY DEFECTIVE RETURN</span>
            <span class="gc-cart__trust-row">// QUESTIONS? <a href="mailto:contact@gadgetconnections.com">contact@gadgetconnections.com</a></span>
          </div>
        </div>
      </div>

    {%- endform -%}
  {%- else -%}
    <div class="gc-cart__empty">
      <h2>:: buffer empty</h2>
      <p>{{ 'general.cart.empty' | t }}</p>
      <p style="margin-top:20px;">
        <a href="{{ routes.all_products_collection_url }}" class="gc-btn">&gt; {{ 'general.cart.continue_shopping' | t | upcase }} _</a>
      </p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow override"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro copy",
      "default": "<p></p>"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background style",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "panel",
          "label": "Panel"
        },
        {
          "value": "muted",
          "label": "Muted"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show order note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_taxes_copy",
      "label": "Show taxes/shipping note",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#d4d6db"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Cart",
      "category": "Shopify Defaults"
    }
  ]
}
{% endschema %}
